<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FUNDO -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#090D12"/>
        </shape>
    </item>

    <!-- LOGO CENTRAL -->
    <item
        android:gravity="center"
        android:drawable="@drawable/splash" />

    <!--
        BRANDING INFERIOR.

        A imagem usada aqui é:

        splash_facebook_logo.png

        Ela pode ser substituída manualmente depois
        pelo MT Manager mantendo o mesmo nome.
    -->
    <item
        android:gravity="bottom|center_horizontal"
        android:bottom="55dp"
        android:drawable="@drawable/splash_facebook_logo" />

</layer-list>
